# --- LLM provider config ---
# This backend talks to any OpenAI-compatible chat completions endpoint.
# Pick ONE provider below and fill in its values. Groq is the default
# (fast, free tier available). To switch to Gemini, just change these
# three lines — no code changes needed.

# --- Option A: Groq (default, recommended — fast + free tier) ---
# Get a key at https://console.groq.com/keys
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# --- Option B: Google Gemini (OpenAI-compatible endpoint) ---
# Get a key at https://aistudio.google.com/apikey
# LLM_API_KEY=your_gemini_api_key_here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# --- Option C: OpenAI (if you ever get credits) ---
# LLM_API_KEY=your_openai_api_key_here
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:3000
